rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /cows/{cowId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /donations/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /expenses/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /volunteers/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /products/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /goshala/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /healthRecords/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /serviceRecords/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}