rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           (!('role' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) ||
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Admin')) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin') &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false)
        );
    }

    function isStaff() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function staffHasPermission(perm) {
      return isStaff() &&
        ('permissions' in getUserData()) &&
        (perm in getUserData().permissions);
    }

    function canManageModule(perm) {
      return isAdmin() || staffHasPermission(perm);
    }

    match /admins/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId &&
        (isAdmin() || request.resource.data.role == 'viewer' || !('role' in request.resource.data));
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isActive == resource.data.isActive);
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if canManageModule('staff');
    }

    match /cows/{cowId} {
      allow read: if true;
      allow create, update: if canManageModule('cows');
      allow delete: if isAdmin();
    }

    match /feedStock/{itemId} {
      allow read: if signedIn();
      allow create, update: if canManageModule('feed');
      allow delete: if isAdmin();
    }

    match /feedTransactions/{txId} {
      allow read: if signedIn();
      allow create, update: if canManageModule('feed');
      allow delete: if isAdmin();
    }

    match /donations/{recordId} {
      allow read: if signedIn();
      allow create: if true;
      allow update: if canManageModule('donations') || canManageModule('finance');
      allow delete: if isAdmin();
    }

    match /expenses/{recordId} {
      allow read: if signedIn();
      allow create, update: if canManageModule('finance');
      allow delete: if isAdmin();
    }

    match /volunteers/{recordId} {
      allow read: if signedIn();
      allow create, update: if canManageModule('volunteers');
      allow delete: if isAdmin();
    }

    match /products/{recordId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /goshala/{recordId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /healthRecords/{recordId} {
      allow read: if signedIn();
      allow create, update: if canManageModule('health');
      allow delete: if isAdmin();
    }

    match /serviceRecords/{recordId} {
      allow read: if signedIn();
      allow create, update: if canManageModule('cows');
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}